# --- Postgres ---
POSTGRES_USER=brainboard
POSTGRES_PASSWORD=change_me
POSTGRES_DB=brainboard
DATABASE_URL=postgresql+psycopg://brainboard:change_me@postgres:5432/brainboard

# --- App ---
APP_ENV=production
SECRET_KEY=change_me
WEBHOOK_SHARED_SECRET=change_me

# --- Reverse proxy / TLS (docker-compose.yml's caddy service) ---
# Your domain, pointed at the VPS's IP via an A record. Caddy auto-issues
# a Let's Encrypt cert for it -- no manual cert config needed. Also what
# DIALER_PUBLIC_BASE_URL below should be built from (https://<DOMAIN>).
DOMAIN=

# --- Google Workspace integration ---
# Path to a service-account JSON key with Sheets/Calendar/Drive scopes,
# shared with edit access on the Master Log V2 spreadsheet, target
# Calendar, and the Drive dossier folders.
GOOGLE_SERVICE_ACCOUNT_FILE=/app/secrets/google-service-account.json
GOOGLE_MASTER_LOG_SHEET_ID=
GOOGLE_CALENDAR_ID=primary
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- Telemetry / macro data providers (silo lead-gen sweeps) ---
# Leave blank to keep an adapter disabled (it will no-op instead of erroring).
# CME Globex MDP 3.0, via Databento (databento.com) -- a licensed
# redistributor of CME's direct-exchange feed, reachable over plain HTTPS
# instead of requiring a CME market-data license + colocation. Get a key
# at databento.com; see app/services/telemetry/cme_globex.py.
DATABENTO_API_KEY=
IMPORT_GENIUS_API_KEY=
SEAVANTAGE_API_KEY=
REGRID_API_KEY=
HIGHERGOV_API_KEY=
# Datalastic and VesselFinder are both AIS vessel-tracking APIs, same as
# SeaVantage -- all three feed Oil & Gas / Refining Silo lead-gen. Default
# AOI is the Houston Ship Channel / Gulf of Mexico approach; the endpoint
# path/response shape wasn't verified against live docs, confirm against
# your actual API plan -- see app/services/telemetry/{datalastic,vesselfinder}.py.
# These two keys also power one of the two USACE lock-disruption channels
# below (an AIS proxy: idle barges queuing at the lock). Feeds CME Macro
# Funnel lead-gen (barge congestion on the Mississippi/Illinois grain
# corridor as a leading indicator for Chicago commodities-market
# volatility) -- review MONITORED_LOCKS in app/services/telemetry/usace.py.
DATALASTIC_API_KEY=
VESSELFINDER_API_KEY=
# USACE's *other* channel: the real CWMS Data API (confirmed against
# https://github.com/USACE/cwms-data-api -- not a guess), which reports
# gate-change operational activity per reservoir project. GET requests
# for this data are keyless per USACE's own FAQ, so this is optional --
# only set it if your office/endpoint combination turns out to need one.
# What IS required: fill in each MONITORED_LOCKS entry's office/project_id
# in app/services/telemetry/usace.py (self-serve lookup instructions are
# in that file's module docstring) -- left blank by default since I can't
# confirm those exact CWMS project IDs without a live session.
CWMS_API_KEY=
# UCC filings + SOS corporate registries are per-state; configure endpoints
# in app/services/telemetry/ucc_filings.py / sos_registries.py per your states of operation.

# --- Enrichment providers (per-lead lookups, "Lead Enrichment" section) ---
# Cobalt Intelligence and Apollo.io also feed CME Macro Funnel lead-gen
# sweeps off this same key -- Cobalt's sweep additionally needs
# MONITORED_SEARCHES populated in app/services/telemetry/cobalt_intelligence.py
# (it's a per-entity lookup API looped over a watch-list, not a bulk feed);
# Apollo's sweep uses an org-search endpoint, see app/services/telemetry/apollo.py.
COBALT_INTELLIGENCE_API_KEY=
# Also powers cross-provider entity resolution (fuzzy company-name
# matching, catching DBAs/LLC-suffix/punctuation variants a raw substring
# check misses) in the CME Macro Funnel waterfall and the River
# Surveillance engine's entity resolution -- see
# app/services/entity_matching.py. Falls back to substring matching when
# left blank, so both keep working (just less precisely) without it.
INTERZOID_API_KEY=
APOLLO_API_KEY=
OPENFDA_API_KEY=
DEEPGRAM_API_KEY=

# --- 3D Globe data sources ---
# GFW_API_KEY and GDELT_API_KEY below are also used by their CME Macro
# Funnel telemetry sweeps (app/services/telemetry/{gfw_4wings,gdelt}.py).
GFW_API_KEY=
# Defaults to GFW's public fishing-effort dataset. If your GFW API plan
# includes broader AIS marine-traffic (non-fishing vessels) or SAR "dark
# vessel" detection, set this to that dataset's ID instead -- check your
# plan/GFW docs for the exact string, see app/services/globe/gfw_4wings.py.
GFW_DATASET=public-global-fishing-effort:latest
# GDELT's GEO 2.0 API is free/keyless at normal volume -- the conflict-zone
# layer works with this left blank. Only set it if GDELT ever requires a key.
GDELT_API_KEY=
# CesiumJS globe (app/templates/globe.html). Get your own token at
# cesium.com/ion -- this project can't generate one for you. Left blank,
# the globe still renders fully using Cesium's own bundled offline
# imagery (lower resolution, no terrain) instead of failing outright.
# Note this is inherently a client-visible token (used in browser JS),
# not a hidden server secret -- restrict it by referrer/domain in your
# ion account dashboard, the same way you'd scope a Mapbox/Google Maps
# public token, rather than treating it like an API key that must stay
# server-side.
CESIUM_ION_TOKEN=

# --- Brain (shadow-mode scoring engine) ---
BRAIN_SHADOW_MODE_LEAD_THRESHOLD=1000

# --- River surveillance engine (app/services/river_surveillance.py) ---
# Off by default -- no background network polling starts without this
# explicit opt-in. Reuses DATALASTIC_API_KEY/VESSELFINDER_API_KEY/
# CWMS_API_KEY/IMPORT_GENIUS_API_KEY/SEAVANTAGE_API_KEY above; no separate
# credentials needed.
RIVER_SURVEILLANCE_ENABLED=false
RIVER_SURVEILLANCE_POLL_INTERVAL_SECONDS=900
RIVER_SURVEILLANCE_IDLE_SPEED_KNOTS=0.5
RIVER_SURVEILLANCE_DISTRESS_IDLE_HOURS=36.0
RIVER_SURVEILLANCE_VELOCITY_ANOMALY_HOURS=4.0
RIVER_SURVEILLANCE_BASELINE_WINDOW_DAYS=90
RIVER_SURVEILLANCE_EXPANSION_MULTIPLIER=1.5

# --- SignalWire dialer (app/services/signalwire_adapter.py, app/services/dialer.py) ---
# Inert until all three are set -- same "no key -> no-op" pattern as every
# other provider above. Get these from your SignalWire Space dashboard.
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
# No scheme, no trailing slash, e.g. "yourspace.signalwire.com"
SIGNALWIRE_SPACE_URL=
# Validates SignalWire's call-status/LaML webhook signatures. Leave blank
# only for local testing against a tunnel you control -- see
# signalwire_adapter.py::verify_webhook_signature's docstring for what's
# confirmed vs. assumed about this scheme.
SIGNALWIRE_WEBHOOK_SIGNING_KEY=
# Publicly reachable base URL SignalWire calls back to (your ngrok tunnel
# or production domain). Required before any real outbound call can be
# placed -- the dialer refuses to dial without it.
DIALER_PUBLIC_BASE_URL=
